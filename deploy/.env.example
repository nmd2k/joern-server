# Copy to deploy/.env and adjust. Joern HTTP API: https://docs.joern.io/server/

# --- compose.dev.yml ---
# Host port published to your machine (maps to container :8080).
JOERN_PUBLISH_PORT=8080

# --- compose.scale.yml ---
# Host port for HAProxy HTTP frontend.
JOERN_HTTP_PORT=8080

# Internal Joern HTTP server port (proxy forwards /query-sync to this).
JOERN_INTERNAL_PORT=18080

# Proxy timeout (seconds) for forwarding /query-sync to Joern internal server.
JOERN_QUERY_TIMEOUT_SEC=600

# JVM heap (-J-Xmx) for the Joern REPL. Container limit must exceed heap + parse/ overhead.
JOERN_JAVA_XMX=4g
JOERN_MEMORY_LIMIT=10g

JOERN_IMAGE_TAG=local

# HTTP basic auth (both must be set to enable)
JOERN_SERVER_AUTH_USERNAME=joern
JOERN_SERVER_AUTH_PASSWORD=change-me

# --- CPG storage ---
# Single host directory whose contents are bind-mounted into /workspace/cpg inside each container.
# Both cpg-out (active working set) and cpg-archive (persistent cache) live here as subdirs,
# ensuring all archive→out copies are intra-disk (fast).
#
#   <CPG_BASE_DIR>/out/      ← active CPGs, one per sample_id
#   <CPG_BASE_DIR>/archive/  ← persistent cache keyed by source_hash
#
# This is the only CPG path you need to configure for production.
CPG_BASE_DIR=/workspace/cpg

# Optional overrides (rarely needed — prefer CPG_BASE_DIR above):
# CPG_OUT_DIR=/datadrive/cpg/out
# CPG_ARCHIVE_DIR=/datadrive/cpg/archive

# Archive LRU eviction limits
CPG_ARCHIVE_MAX_COUNT=500
CPG_ARCHIVE_MAX_GB=100

# Restart Joern JVM after cleanup when idle container RSS exceeds this (MB). 0 = disabled.
JOERN_MEMORY_RESTART_MB=6144
JOERN_DRAIN_SEC=7

# Staggered restart: random jitter (seconds) before committing to drain+restart.
JOERN_RESTART_JITTER_SEC=30
# Minimum healthy backends required before a replica will restart.
JOERN_RESTART_MIN_PEERS=2
# HAProxy VIP URL for cluster health gating. Empty string disables the gate.
JOERN_HAPROXY_VIP=http://joern-haproxy:8080

# Staging only: expose POST /debug/drain for live drain tests. Must be 0 in production.
JOERN_ENABLE_DRAIN_TEST=0

# --- Dev only (compose.dev.yml, not used in compose.scale.yml) ---
# Host directory bind-mounted read-only to /workspace/datasets for quick source_root testing.
# DATASETS_HOST_DIR=/path/to/your/datasets
# Colon-separated container allowlist for POST /parse/repo { "source_root": ... }
PARSE_REPO_ALLOWED_ROOTS=/workspace/datasets

# Self-healing (autoheal sidecar)
AUTOHEAL_INTERVAL=10
AUTOHEAL_START_PERIOD=180

# --- compose.monitoring.yml ---
# GID of the host docker group (stat -c %g /var/run/docker.sock). Required for Prometheus docker_sd.
DOCKER_GID=999
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
