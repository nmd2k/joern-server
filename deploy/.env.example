# Copy to deploy/.env and adjust. Joern HTTP API: https://docs.joern.io/server/

# --- compose.dev.yml ---
# Host port published to your machine (maps to container :8080).
JOERN_PUBLISH_PORT=8080

# --- compose.scale.yml ---
# Host port for HAProxy HTTP frontend.
JOERN_HTTP_PORT=8080

# Internal Joern HTTP server port (proxy forwards /query-sync to this).
JOERN_INTERNAL_PORT=18080

# Proxy timeout (seconds) for forwarding /query-sync to Joern internal server.
JOERN_QUERY_TIMEOUT_SEC=600

# JVM heap (-J-Xmx). Container cgroup limit must exceed heap + ~8g non-heap.
JOERN_JAVA_XMX=1g
JOERN_MEMORY_LIMIT=4g

JOERN_IMAGE_TAG=local

# HTTP basic auth (both must be set to enable)
JOERN_SERVER_AUTH_USERNAME=joern
JOERN_SERVER_AUTH_PASSWORD=change-me

# CPG archive cache (hash dedup, LRU eviction)
CPG_ARCHIVE_DIR=/workspace/cpg-archive
CPG_ARCHIVE_MAX_COUNT=100
CPG_ARCHIVE_MAX_GB=50

# Self-healing (autoheal sidecar)
AUTOHEAL_INTERVAL=10
AUTOHEAL_START_PERIOD=180

# --- compose.monitoring.yml ---
# GID of the host docker group (stat -c %g /var/run/docker.sock). Required for Prometheus docker_sd.
DOCKER_GID=999
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# Optional for deploy/run-joern.sh (standalone runner):
# JOERN_SERVER_PORT=16162
# Optional Scala script imported at Joern startup (usually unset — use raw CPGQL only)
# JOERN_IMPORT_SC=/path/to/custom.sc
