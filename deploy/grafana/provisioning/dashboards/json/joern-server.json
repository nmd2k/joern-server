      "id": 41,
      "title": "Parse 502/504 rate",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(joern_proxy_parse_requests_total{status=~\"502|504\"}[2m])) or vector(0)", "legendFormat": "errors/sec" }]
