{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 8 }, { "color": "green", "value": 10 }] } } },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Replicas UP",
      "type": "stat",
      "targets": [{ "expr": "count(up{job=\"joern-proxy\"} == 1)", "legendFormat": "" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "0": { "color": "red", "text": "DOWN" } }, "type": "value" }, { "options": { "1": { "color": "green", "text": "UP" } }, "type": "value" }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } },
      "gridPos": { "h": 4, "w": 12, "x": 3, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Joern REPL UP",
      "type": "stat",
      "targets": [{ "expr": "joern_proxy_joern_up and on(instance) up{job=\"joern-proxy\"}", "legendFormat": "{{container}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] } } },
      "gridPos": { "h": 4, "w": 9, "x": 15, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Container RAM %",
      "type": "stat",
      "targets": [{ "expr": "(joern_proxy_memory_container_usage_bytes / joern_proxy_memory_container_limit_bytes) * 100", "legendFormat": "{{container}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "decbytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 10,
      "title": "Container RAM usage per replica",
      "type": "timeseries",
      "targets": [
        { "expr": "joern_proxy_memory_container_usage_bytes", "legendFormat": "{{container}} usage" },
        { "expr": "joern_proxy_memory_container_limit_bytes", "legendFormat": "{{container}} limit" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "decbytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 11,
      "title": "Proxy RSS per replica",
      "type": "timeseries",
      "targets": [{ "expr": "joern_proxy_memory_rss_bytes", "legendFormat": "{{container}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 20,
      "title": "Query-sync rate per replica",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(joern_proxy_query_sync_requests_total[2m])) by (container)", "legendFormat": "{{container}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 21,
      "title": "Query-sync latency (p50 avg)",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(joern_proxy_query_sync_duration_seconds_sum[2m])) by (container) / sum(rate(joern_proxy_query_sync_duration_seconds_count[2m])) by (container)", "legendFormat": "{{container}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 30,
      "title": "Query-sync 502/504 rate",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(joern_proxy_query_sync_requests_total{status=~\"502|504\"}[2m])) or vector(0)", "legendFormat": "errors/sec" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
