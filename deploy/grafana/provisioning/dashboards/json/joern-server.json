      "targets": [{ "expr": "sum(rate(joern_proxy_query_sync_requests_total{status=~\"502|504\"}[2m])) / sum(rate(joern_proxy_query_sync_requests_total[2m])) or vector(0)", "legendFormat": "error ratio" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
